    "guardrails",
    "agent-tool",
    "ai",
    "rlcd"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Venomous-101/n8n-nodes-jev-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venomous-101/n8n-nodes-jev-ai.git"
  },
  "author": {
    "name": "Ali Abdullah",
    "email": "aliabdullah0k09@gmail.com",
    "url": "https://github.com/Venomous-101"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
